{
  "name": "the-forge",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm install && npm install --prefix client && npm install --prefix server && npm run build",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
