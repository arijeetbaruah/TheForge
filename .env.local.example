# Firebase Client Configuration (Required for Frontend Auth)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="thy-forge-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="thy-forge-project"
VITE_FIREBASE_APP_ID="1:..."

# Google Sheets Integration (Server-side)
# If omitted, Vercel routes will automatically fall back to an in-memory database
# APPS_SCRIPT_URL="https://script.google.com/macros/s/.../exec"

# Firebase Admin Service Account (Server-side, JSON string on one line)
# If omitted, Admin user listing operations will fall back to simulated mock accounts
# FIREBASE_ADMIN_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "...", ...}'
